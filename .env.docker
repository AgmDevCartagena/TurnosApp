# Variables de entorno para producción con Docker

# Puerto de la aplicación
PORT=3001

# URI de MongoDB (apunta al contenedor de MongoDB)
MONGO_URI=mongodb://mongodb:27017/turnos_app

# Secreto para las sesiones (cambiar en producción)
SESSION_SECRET=sistema_gestion_secret_production_2025

# Entorno de ejecución
NODE_ENV=production

# Configuración de la aplicación
APP_NAME=Sistema de Gestión Empresarial
APP_VERSION=2.0.0
