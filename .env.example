# ============================================
# Plataforma Control de Compras AGM
# Variables de entorno
# ============================================

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_compras?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tu-refresh-secreto-super-seguro-cambiar-en-produccion
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=3001
API_PREFIX=api/v1
API_CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@gestion-compras.com

# Entorno
NODE_ENV=development
