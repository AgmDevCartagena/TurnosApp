{
  "name": "gestion_empresarial",
  "version": "2.0.0",
  "description": "Sistema Integrado de Gestión - Módulos de Turnos y Nómina",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "migrate": "node scripts/migrarEmpresaId.js",
    "seed": "node scripts/seedMultiempresa.js",
    "init-db": "node init-db.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "joi": "^18.0.1",
    "jspdf": "^3.0.3",
    "mongodb": "^6.20.0",
    "mongoose": "^7.0.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=14"
  }
}
