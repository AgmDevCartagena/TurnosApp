{
  "name": "gestion_empresarial",
  "version": "2.0.0",
  "packageManager": "pnpm@10.20.0",
  "description": "Sistema Integrado de Gestión - Módulos de Turnos y Nómina",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "cross-env NODE_ENV=test jest --forceExit --detectOpenHandles --testPathIgnorePatterns=tests/e2e",
    "test:watch": "jest --watch --testPathIgnorePatterns=tests/e2e",
    "test:coverage": "jest --coverage --forceExit --testPathIgnorePatterns=tests/e2e",
    "test:e2e": "cross-env NODE_ENV=test jest tests/e2e/full.e2e.test.js --forceExit --detectOpenHandles --runInBand --testTimeout=30000",
    "test:seguridad": "node --test tests/unit/inputValidator.test.js",
    "cleanup:db": "node scripts/limpiarDatosContaminados.js",
    "cleanup:db:fix": "node scripts/limpiarDatosContaminados.js --fix",
    "migrate": "node scripts/migrarEmpresaId.js",
    "migrate:pg": "node scripts/migrarMongoAPostgres.js",
    "seed": "node scripts/seedMultiempresa.js",
    "seed:areas": "node scripts/seedAreas.js",
    "seed:nomina": "node scripts/seedParametrosNomina.js",
    "seed:pg": "node prisma/seed.js",
    "init-db": "node init-db.js",
    "hash-passwords": "node scripts/hashPasswords.js",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:studio": "pnpm exec prisma studio",
    "prisma:reset": "pnpm exec prisma migrate reset --force"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 20000
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "joi": "^18.0.1",
    "jspdf": "^3.0.3",
    "mongodb": "^6.20.0",
    "mongoose": "^7.0.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "tsparticles-slim": "^2.12.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=14"
  }
}
