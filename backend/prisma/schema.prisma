generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMERACIONES ────────────────────────────────────────────────────────────

enum EstadoGeneral {
  activo
  inactivo
}

enum EstadoEmpresa {
  activa
  inactiva
}

enum RolUsuario {
  super_admin
  admin
  gestor_turnos
  gestor_nomina
  usuario
  consulta
}

enum TipoModulo {
  turnos
  nomina
  usuarios
  parametros
  reportes
  empresas
  areas
  transporte
  programacion_operativa
  ia
}

enum EstadoProgramacionOp {
  borrador
  validada
  aprobada
  aprobada_con_rechazos
  enviada
  cerrada
  anulada
}

enum EstadoAprobacionPersona {
  pendiente
  aprobado
  rechazado
}

enum TipoMovimientoTransporte {
  recogida
  salida
  retorno
}

enum TipoServicioAlimentacion {
  merienda
  cena
  merienda_nocturna
  otro
}

enum EstadoServicioAlimentacion {
  pendiente
  asignado
  recibido
  entregado
  con_novedad
  cancelado
}

enum TipoProgramacionPersona {
  normal
  extendido
  turno_b
  otro
}

enum TipoNovedadOperativa {
  persona_no_asistio
  cambio_responsable
  merienda_no_recibida
  cena_incompleta
  cambio_turno
  persona_adicional
  error_listado
  cambio_ruta
  cambio_conductor
  otra
}

enum TipoContrato {
  indefinido
  fijo
  obra_labor
  aprendizaje
  prestacion_servicios
}

enum TipoTurno {
  ADMINISTRATIVO
  TURNO_100
  TURNO_300
  TURNO_400
  TECNICO
  CONDUCTOR
  PERSONALIZADO
  MANUAL
}

enum TipoValorParametro {
  porcentaje
  valor_fijo
  horas
  dias
}

enum TipoConcepto {
  devengado
  deduccion
  prestacion
  informativo
}

enum EstadoLiquidacion {
  borrador
  aprobada
  anulada
}

enum TipoNovedad {
  incapacidad
  licencia_remunerada
  licencia_no_remunerada
  vacaciones
  bonificacion
  descuento
  embargo
  otro
}

enum EstadoNovedad {
  activa
  aplicada
  anulada
}

// ─── EMPRESA ──────────────────────────────────────────────────────────────────

model Empresa {
  id          String        @id @default(uuid())
  nombre      String        @db.VarChar(150)
  nit         String?       @unique @db.VarChar(30)
  razonSocial String?       @db.VarChar(200)
  dominio     String?       @db.VarChar(100)
  colorTema        String        @default("#667eea") @db.VarChar(10)
  logoUrl          String?
  logoPath         String?
  logoMimeType     String?       @db.VarChar(50)
  logoOriginalName String?
  logoSize         Int?
  estado           EstadoEmpresa @default(activa)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  usuarios         Usuario[]
  usuariosEmpresas UsuarioEmpresa[]  // ← relación multiempresa
  areas            Area[]
  empleados        Empleado[]
  modulos          EmpresaModulo[]
  parametros       ParametroNomina[]
  conceptos        ConceptoNomina[]
  liquidaciones    LiquidacionNomina[]
  novedades        NovedadNomina[]
  turnos           Turno[]
  festivos         Festivo[]
  configTurnosOp        ConfiguracionTurnoOp[]
  conductores           ConductorTransporte[]
  vehiculos             VehiculoTransporte[]
  ubicaciones           UbicacionRuta[]
  programacionesTransporte ProgramacionTransporte[]
  configuracionIA          ConfiguracionIA?

  @@index([estado])
  @@map("empresas")
}

// ─── MODULO ───────────────────────────────────────────────────────────────────

model Modulo {
  id          String     @id @default(uuid())
  codigo      TipoModulo @unique
  nombre      String     @db.VarChar(80)
  descripcion String?
  activo      Boolean    @default(true)

  empresas         EmpresaModulo[]
  usuariosEmpresas UsuarioEmpresaModulo[]

  @@map("modulos")
}

model EmpresaModulo {
  id               String    @id @default(uuid())
  empresaId        String
  moduloId         String
  habilitado       Boolean   @default(true)
  fechaActivacion  DateTime?
  fechaVencimiento DateTime?
  createdAt        DateTime  @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  modulo  Modulo  @relation(fields: [moduloId], references: [id])

  @@unique([empresaId, moduloId])
  @@index([empresaId, habilitado])
  @@map("empresa_modulos")
}

// ─── USUARIO ──────────────────────────────────────────────────────────────────

model Usuario {
  id           String     @id @default(uuid())
  username     String     @unique @db.VarChar(60)
  passwordHash String
  nombre       String     @db.VarChar(150)
  correo       String?    @db.VarChar(200)
  empresaId    String?    // ← backward compat — UNA empresa (legacy)
  rol          RolUsuario @default(usuario) // ← rol global (super_admin usa este)
  activo       Boolean    @default(true)
  ultimoAcceso DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  empresa                 Empresa?           @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  modulosPermitidos       UsuarioModulo[]
  areas                   UsuarioArea[]
  empresas                UsuarioEmpresa[]   // ← relación multiempresa
  liquidacionesCalculadas LiquidacionNomina[] @relation("CalculadoPor")
  liquidacionesAprobadas  LiquidacionNomina[] @relation("AprobadoPor")
  novedadesRegistradas    NovedadNomina[]

  @@index([empresaId, activo])
  @@index([rol])
  @@map("usuarios")
}

model UsuarioModulo {
  usuarioId String
  modulo    TipoModulo

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, modulo])
  @@map("usuario_modulos")
}

// ─── ÁREA ─────────────────────────────────────────────────────────────────────

model Area {
  id          String        @id @default(uuid())
  empresaId   String
  nombre      String        @db.VarChar(100)
  codigo      String?       @db.VarChar(20)
  descripcion String?
  estado      EstadoGeneral @default(activo)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  empresa          Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarios           UsuarioArea[]
  usuariosEmpresas   UsuarioEmpresaArea[]
  empleados          Empleado[]
  turnos             Turno[]
  detallesTransporte DetalleProgramTransporte[]

  @@unique([empresaId, nombre])
  @@index([empresaId, estado])
  @@map("areas")
}

model UsuarioArea {
  usuarioId String
  areaId    String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, areaId])
  @@index([areaId])
  @@map("usuario_areas")
}

// ─── ROL (tabla administrable, separada del enum global) ─────────────────────

model Rol {
  id          String        @id @default(uuid())
  codigo      String        @unique @db.VarChar(60)
  nombre      String        @db.VarChar(100)
  descripcion String?
  tipo        String        @default("empresa") @db.VarChar(30)
  estado      EstadoGeneral @default(activo)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  usuariosEmpresas UsuarioEmpresa[]
  permisos         RolPermiso[]

  @@map("roles")
}

// ─── PERMISO ──────────────────────────────────────────────────────────────────

model Permiso {
  id          String        @id @default(uuid())
  codigo      String        @unique @db.VarChar(100)
  nombre      String        @db.VarChar(150)
  descripcion String?       @db.VarChar(500)
  modulo      String        @db.VarChar(60)
  recurso     String        @db.VarChar(60)
  accion      String        @db.VarChar(30)
  orden       Int           @default(0)
  estado      EstadoGeneral @default(activo)
  createdAt   DateTime      @default(now())

  roles    RolPermiso[]
  usuarios UsuarioEmpresaPermiso[]

  @@index([modulo, orden])
  @@index([estado])
  @@map("permisos")
}

model RolPermiso {
  rolId     String
  permisoId String

  rol     Rol     @relation(fields: [rolId],     references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

// ─── USUARIO × EMPRESA (N:M con rol, módulos, áreas y permisos por empresa) ──

model UsuarioEmpresa {
  id                   String        @id @default(uuid())
  usuarioId            String
  empresaId            String
  rolId                String
  empresaActivaDefault Boolean       @default(false)
  estado               EstadoGeneral @default(activo)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  rol      Rol      @relation(fields: [rolId],      references: [id])

  areas    UsuarioEmpresaArea[]
  modulos  UsuarioEmpresaModulo[]
  permisos UsuarioEmpresaPermiso[]

  @@unique([usuarioId, empresaId])
  @@index([usuarioId])
  @@index([empresaId])
  @@map("usuario_empresa")
}

model UsuarioEmpresaArea {
  id               String @id @default(uuid())
  usuarioEmpresaId String
  areaId           String

  usuarioEmpresa UsuarioEmpresa @relation(fields: [usuarioEmpresaId], references: [id], onDelete: Cascade)
  area           Area           @relation(fields: [areaId],           references: [id], onDelete: Cascade)

  @@unique([usuarioEmpresaId, areaId])
  @@index([areaId])
  @@map("usuario_empresa_areas")
}

model UsuarioEmpresaModulo {
  id               String  @id @default(uuid())
  usuarioEmpresaId String
  moduloId         String
  activo           Boolean @default(true)

  usuarioEmpresa UsuarioEmpresa @relation(fields: [usuarioEmpresaId], references: [id], onDelete: Cascade)
  modulo         Modulo         @relation(fields: [moduloId],         references: [id], onDelete: Cascade)

  @@unique([usuarioEmpresaId, moduloId])
  @@map("usuario_empresa_modulos")
}

model UsuarioEmpresaPermiso {
  id               String   @id @default(uuid())
  usuarioEmpresaId String
  permisoId        String
  permitido        Boolean  @default(true)
  createdAt        DateTime @default(now())

  usuarioEmpresa UsuarioEmpresa @relation(fields: [usuarioEmpresaId], references: [id], onDelete: Cascade)
  permiso        Permiso        @relation(fields: [permisoId],        references: [id], onDelete: Cascade)

  @@unique([usuarioEmpresaId, permisoId])
  @@map("usuario_empresa_permisos")
}

// ─── EMPLEADO ─────────────────────────────────────────────────────────────────

model Empleado {
  id              String        @id @default(uuid())
  empresaId       String
  areaId          String?
  documento       String        @db.VarChar(20)
  nombre          String        @db.VarChar(100)
  apellidos       String?       @db.VarChar(100)
  cargo           String?       @db.VarChar(80)
  salario         Decimal       @default(0) @db.Decimal(14, 2)
  tipoContrato    TipoContrato  @default(indefinido)
  estado          EstadoGeneral @default(activo)
  fechaIngreso    DateTime?     @db.Date
  fechaRetiro     DateTime?     @db.Date
  fechaCumpleanos DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  empresa       Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  area          Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  turnos        Turno[]
  liquidaciones LiquidacionNomina[]
  novedades     NovedadNomina[]
  detallesTransporte DetalleProgramTransporte[]

  @@unique([documento, empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, areaId])
  @@map("empleados")
}

// ─── TURNO ────────────────────────────────────────────────────────────────────

model Turno {
  id                String     @id @default(uuid())
  empresaId         String
  empleadoId        String
  areaId            String?
  turno             String     @db.VarChar(60)
  tipoTurno         TipoTurno?
  tablaDescanso     String?    @db.VarChar(10)
  fechaInicio       DateTime
  fechaFin          DateTime
  horaInicio        String?    @db.VarChar(5)
  horaFin           String?    @db.VarChar(5)
  esTurnoPartido    Boolean    @default(false)
  horaInicio2       String?    @db.VarChar(5)
  horaFin2          String?    @db.VarChar(5)
  activo            Boolean    @default(true)
  cronogramaMongoId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  area     Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([empresaId, empleadoId])
  @@index([empresaId, fechaInicio, fechaFin])
  @@index([empresaId, areaId, fechaInicio])
  @@map("turnos")
}

// ─── PARÁMETROS DE NÓMINA ─────────────────────────────────────────────────────

model ParametroNomina {
  id            String             @id @default(uuid())
  empresaId     String
  codigo        String             @db.VarChar(60)
  nombre        String             @db.VarChar(120)
  descripcion   String?
  valor         Decimal            @db.Decimal(14, 4)
  tipoValor     TipoValorParametro @default(valor_fijo)
  vigenciaDesde DateTime           @db.Date
  vigenciaHasta DateTime?          @db.Date
  estado        EstadoGeneral      @default(activo)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo, vigenciaDesde])
  @@index([empresaId, codigo, estado])
  @@map("parametros_nomina")
}

// ─── CONCEPTOS DE NÓMINA ──────────────────────────────────────────────────────

model ConceptoNomina {
  id                  String        @id @default(uuid())
  empresaId           String
  codigo              String        @db.VarChar(60)
  nombre              String        @db.VarChar(120)
  descripcion         String?
  tipo                TipoConcepto
  referenciaParametro String?       @db.VarChar(60)
  base                String        @default("salarioBase") @db.VarChar(60)
  formula             String?
  afectaTotal         Boolean       @default(true)
  orden               Int           @default(0)
  vigenciaDesde       DateTime      @db.Date
  vigenciaHasta       DateTime?     @db.Date
  estado              EstadoGeneral @default(activo)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  empresa  Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detalles DetalleLiquidacion[]

  @@unique([empresaId, codigo])
  @@index([empresaId, tipo, estado])
  @@map("conceptos_nomina")
}

// ─── LIQUIDACIÓN DE NÓMINA ────────────────────────────────────────────────────

model LiquidacionNomina {
  id               String            @id @default(uuid())
  empresaId        String
  empleadoId       String
  periodoInicio    DateTime          @db.Date
  periodoFin       DateTime          @db.Date
  salarioBase      Decimal           @db.Decimal(14, 2)
  diasTrabajados   Int               @default(0)
  totalDevengado   Decimal           @default(0) @db.Decimal(14, 2)
  totalDeducciones Decimal           @default(0) @db.Decimal(14, 2)
  netoPagar        Decimal           @default(0) @db.Decimal(14, 2)
  estado           EstadoLiquidacion @default(borrador)
  calculadoPorId   String?
  aprobadoPorId    String?
  fechaAprobacion  DateTime?
  observaciones    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  empleado     Empleado @relation(fields: [empleadoId], references: [id], onDelete: Restrict)
  calculadoPor Usuario? @relation("CalculadoPor", fields: [calculadoPorId], references: [id], onDelete: SetNull)
  aprobadoPor  Usuario? @relation("AprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  detalles     DetalleLiquidacion[]

  @@unique([empresaId, empleadoId, periodoInicio, periodoFin])
  @@index([empresaId, estado])
  @@index([empresaId, periodoInicio, periodoFin])
  @@map("liquidaciones_nomina")
}

model DetalleLiquidacion {
  id             String       @id @default(uuid())
  liquidacionId  String
  conceptoId     String?
  codigoConcepto String       @db.VarChar(60)
  nombreConcepto String       @db.VarChar(120)
  tipo           TipoConcepto
  cantidad       Decimal      @default(0) @db.Decimal(10, 4)
  base           Decimal      @default(0) @db.Decimal(14, 2)
  porcentaje     Decimal      @default(0) @db.Decimal(8, 4)
  valor          Decimal      @db.Decimal(14, 2)
  observacion    String?

  liquidacion LiquidacionNomina @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  concepto    ConceptoNomina?   @relation(fields: [conceptoId], references: [id], onDelete: SetNull)

  @@index([liquidacionId])
  @@index([conceptoId])
  @@map("detalle_liquidacion")
}

// ─── NOVEDADES DE NÓMINA ──────────────────────────────────────────────────────

model NovedadNomina {
  id              String        @id @default(uuid())
  empresaId       String
  empleadoId      String
  tipo            TipoNovedad
  descripcion     String?
  fechaInicio     DateTime      @db.Date
  fechaFin        DateTime      @db.Date
  cantidad        Decimal       @default(0) @db.Decimal(10, 2)
  valor           Decimal       @default(0) @db.Decimal(14, 2)
  observacion     String?
  estado          EstadoNovedad @default(activa)
  registradoPorId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  empleado      Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  registradoPor Usuario? @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([empresaId, empleadoId, fechaInicio])
  @@index([empresaId, tipo, estado])
  @@map("novedades_nomina")
}

// ─── FESTIVOS ─────────────────────────────────────────────────────────────────

model Festivo {
  id        String   @id @default(uuid())
  empresaId String?
  fecha     DateTime @db.Date
  nombre    String   @db.VarChar(100)
  tipo      String   @default("nacional") @db.VarChar(30)
  createdAt DateTime @default(now())

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, fecha])
  @@index([fecha])
  @@map("festivos")
}

// ─── MÓDULO TRANSPORTE Y PROGRAMACIÓN OPERATIVA ────────────────────────────

model ConfiguracionTurnoOp {
  id                   String        @id @default(uuid())
  empresaId            String
  codigo               String        @db.VarChar(40)
  nombreTurno          String        @db.VarChar(80)
  horaInicio           String        @db.VarChar(5)
  horaFin              String        @db.VarChar(5)
  horaExtensionInicio  String?       @db.VarChar(5)
  horaExtensionFin     String?       @db.VarChar(5)
  generaMerienda       Boolean       @default(false)
  generaCena           Boolean       @default(false)
  requiereResponsable  Boolean       @default(false)
  esExtendido          Boolean       @default(false)
  esTurnoNocturno      Boolean       @default(false)
  activo               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo])
  @@index([empresaId, activo])
  @@map("config_turnos_op")
}

model ConductorTransporte {
  id        String        @id @default(uuid())
  empresaId String
  nombre    String        @db.VarChar(150)
  documento String?       @db.VarChar(20)
  telefono  String?       @db.VarChar(20)
  estado    EstadoGeneral @default(activo)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  empresa       Empresa                     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  programaciones ProgramacionTransporte[]

  @@index([empresaId, estado])
  @@map("conductores_transporte")
}

model VehiculoTransporte {
  id          String        @id @default(uuid())
  empresaId   String
  placa       String        @db.VarChar(10)
  descripcion String?       @db.VarChar(100)
  capacidad   Int?
  estado      EstadoGeneral @default(activo)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  empresa        Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  programaciones ProgramacionTransporte[]

  @@unique([empresaId, placa])
  @@index([empresaId, estado])
  @@map("vehiculos_transporte")
}

model UbicacionRuta {
  id          String        @id @default(uuid())
  empresaId   String
  nombre      String        @db.VarChar(100)
  descripcion String?
  estado      EstadoGeneral @default(activo)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  empresa  Empresa                       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detalles DetalleProgramTransporte[]

  @@unique([empresaId, nombre])
  @@index([empresaId, estado])
  @@map("ubicaciones_ruta")
}

model ProgramacionTransporte {
  id               String                   @id @default(uuid())
  empresaId        String
  fecha            DateTime                 @db.Date
  horaSalida       String                   @db.VarChar(5)
  tipoMovimiento   TipoMovimientoTransporte @default(salida)
  titulo           String?                  @db.VarChar(150)
  conductorId      String?
  vehiculoId       String?
  placaManual      String?                  @db.VarChar(20)
  conductorManual  String?                  @db.VarChar(100)
  estado           EstadoProgramacionOp     @default(borrador)
  observaciones    String?
  creadoPorId      String?
  revisadoPorId    String?
  aprobadoPorId    String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  empresa    Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  conductor  ConductorTransporte? @relation(fields: [conductorId], references: [id], onDelete: SetNull)
  vehiculo   VehiculoTransporte?  @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)

  detalles             DetalleProgramTransporte[]
  serviciosAlimentacion ServicioAlimentacion[]
  novedades            NovedadOperativa[]

  @@index([empresaId, fecha])
  @@index([empresaId, estado])
  @@map("programaciones_transporte")
}

model DetalleProgramTransporte {
  id                     String                   @id @default(uuid())
  programacionId         String
  empresaId              String
  empleadoId             String?
  nombreEmpleado         String                   @db.VarChar(150)
  documentoEmpleado      String?                  @db.VarChar(20)
  areaNombre             String?                  @db.VarChar(100)
  areaId                 String?
  coordinadorNombre      String?                  @db.VarChar(150)
  cargo                  String?                  @db.VarChar(80)
  fecha                  DateTime                 @db.Date
  horaInicio             String                   @db.VarChar(5)
  horaFin                String                   @db.VarChar(5)
  tipoProgramacion       TipoProgramacionPersona  @default(normal)
  requiereMerienda       Boolean                  @default(false)
  requiereCena           Boolean                  @default(false)
  requiereRuta           Boolean                  @default(true)
  ubicacionId            String?
  ubicacionTexto         String?                  @db.VarChar(150)
  esResponsableAlimentacion Boolean               @default(false)
  tipoResponsabilidad    String?                  @db.VarChar(30)
  orden                  Int                      @default(0)
  observacion            String?
  estadoAprobacion       EstadoAprobacionPersona  @default(pendiente)
  motivoRechazo          String?                  @db.VarChar(500)
  aprobadoPorId          String?
  aprobadoEn             DateTime?
  rechazadoPorId         String?
  rechazadoEn            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  programacion ProgramacionTransporte @relation(fields: [programacionId], references: [id], onDelete: Cascade)
  empleado     Empleado?              @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  ubicacion    UbicacionRuta?         @relation(fields: [ubicacionId], references: [id], onDelete: SetNull)
  area         Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@unique([programacionId, nombreEmpleado, fecha, horaInicio])
  @@index([programacionId])
  @@index([empleadoId])
  @@index([estadoAprobacion])
  @@map("detalles_program_transporte")
}

model ServicioAlimentacion {
  id               String                     @id @default(uuid())
  programacionId   String
  empresaId        String
  fecha            DateTime                   @db.Date
  tipoServicio     TipoServicioAlimentacion
  areaNombre       String?                    @db.VarChar(100)
  responsableNombre String?                   @db.VarChar(150)
  responsableDoc   String?                    @db.VarChar(20)
  cantidadPersonas Int                        @default(0)
  estado           EstadoServicioAlimentacion @default(pendiente)
  observacion      String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  programacion ProgramacionTransporte @relation(fields: [programacionId], references: [id], onDelete: Cascade)

  @@index([programacionId])
  @@index([empresaId, fecha])
  @@map("servicios_alimentacion")
}

model NovedadOperativa {
  id             String               @id @default(uuid())
  programacionId String
  empresaId      String
  fecha          DateTime             @db.Date
  tipoNovedad    TipoNovedadOperativa
  descripcion    String
  empleadoNombre String?              @db.VarChar(150)
  areaNombre     String?              @db.VarChar(100)
  registradoPorId String?
  estado         EstadoGeneral        @default(activo)
  createdAt      DateTime             @default(now())

  programacion ProgramacionTransporte @relation(fields: [programacionId], references: [id], onDelete: Cascade)

  @@index([programacionId])
  @@index([empresaId, fecha])
  @@map("novedades_operativas")
}

// ─── IA ────────────────────────────────────────────────────────────────────────

enum EstadoPropuestaIA {
  borrador
  validada
  aprobada
  aplicada
  rechazada
  expirada
}

enum TipoOperacionIA {
  validacion
  generacion_propuesta
  simulacion
  consulta_asistente
  explicacion
  aprobacion
  aplicacion
}

enum ResultadoOperacionIA {
  exitoso
  fallido
  rechazado
  bloqueado
}

model ConfiguracionIA {
  id                      String   @id @default(uuid())
  empresaId               String   @unique
  habilitada              Boolean  @default(false)
  proveedor               String   @default("openai") @db.VarChar(50)
  modelo                  String   @default("gpt-4o-mini") @db.VarChar(100)
  temperatura             Decimal  @default(0.2) @db.Decimal(3, 2)
  limiteTokensRespuesta   Int      @default(2000)
  limiteMensualTokens     Int?
  permitirDatosNomina     Boolean  @default(false)
  permitirNombres         Boolean  @default(false)
  retencionAuditoriaDias  Int      @default(90)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracion_ia")
}

model PropuestaProgramacionIA {
  id                   String             @id @default(uuid())
  empresaId            String
  areaId               String?
  periodoInicio        DateTime           @db.Date
  periodoFin           DateTime           @db.Date
  nombre               String             @db.VarChar(200)
  objetivo             String             @db.VarChar(60)
  estado               EstadoPropuestaIA  @default(borrador)
  restricciones        Json
  propuesta            Json
  indicadoresBase      Json?
  indicadoresPropuesta Json?
  hallazgos            Json?
  explicacion          String?
  dataHash             String?            @db.VarChar(64)
  creadoPorId          String
  aprobadoPorId        String?
  fechaAprobacion      DateTime?
  version              Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([empresaId, periodoInicio, periodoFin])
  @@index([empresaId, estado])
  @@map("propuestas_programacion_ia")
}

model EjecucionIA {
  id            String              @id @default(uuid())
  empresaId     String
  usuarioId     String
  propuestaId   String?
  tipoOperacion TipoOperacionIA
  proveedor     String?             @db.VarChar(50)
  modelo        String?             @db.VarChar(100)
  promptHash    String?             @db.VarChar(64)
  tokensEntrada Int?
  tokensSalida  Int?
  costoEstimado Decimal?            @db.Decimal(14, 6)
  duracionMs    Int?
  resultado     ResultadoOperacionIA
  codigoError   String?             @db.VarChar(80)
  metadata      Json?
  createdAt     DateTime            @default(now())

  @@index([empresaId, createdAt])
  @@index([empresaId, tipoOperacion])
  @@map("ejecuciones_ia")
}

model ConversacionIA {
  id        String   @id @default(uuid())
  empresaId String
  usuarioId String
  titulo    String?  @db.VarChar(200)
  estado    String   @default("activa") @db.VarChar(20)
  contexto  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mensajes MensajeIA[]

  @@index([empresaId, usuarioId, updatedAt])
  @@map("conversaciones_ia")
}

model MensajeIA {
  id             String   @id @default(uuid())
  conversacionId String
  rol            String   @db.VarChar(20)
  contenido      String
  metadata       Json?
  createdAt      DateTime @default(now())

  conversacion ConversacionIA @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, createdAt])
  @@map("mensajes_ia")
}
