# .env.production.example
#
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.production.example .env.production
#   2. Completar TODOS los valores marcados con <CAMBIAR>
#   3. NUNCA commitear .env.production al repositorio (.gitignore ya lo excluye)
#   4. Rotar SESSION_SECRET y ADMIN_INIT_PASSWORD antes del primer deploy
#
# GENERADOR DE SESSION_SECRET seguro:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
TZ=UTC

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=turnos_user
POSTGRES_PASSWORD=<CAMBIAR_contraseña_segura_min_20_chars>
POSTGRES_DB=turnos_app_pg
DATABASE_URL=postgresql://turnos_user:<CAMBIAR_contraseña_segura_min_20_chars>@postgres:5432/turnos_app_pg

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017/turnos_app

# ── Seguridad de sesión ───────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=<CAMBIAR_minimo_64_chars_aleatorios>

# ── Admin inicial ─────────────────────────────────────────────────────────────
# Solo aplica la primera vez que se crea el usuario superadmin/admin
# Cambiar inmediatamente después del primer acceso
ADMIN_INIT_PASSWORD=<CAMBIAR_contraseña_segura>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Solo el dominio/IP real de producción. Sin localhost. Sin wildcard.
# Ejemplos:
#   ALLOWED_ORIGINS=https://mi-dominio.com
#   ALLOWED_ORIGINS=http://10.250.10.9:3001
ALLOWED_ORIGINS=<CAMBIAR_dominio_o_IP_produccion>

# ── Cookies HTTPS ─────────────────────────────────────────────────────────────
# Poner en true SOLO si hay HTTPS activo (Nginx con SSL)
# Si solo hay HTTP, dejar en false
COOKIE_SECURE=false
HTTPS_ENABLED=false

# ── Proxy (Nginx) ─────────────────────────────────────────────────────────────
# Siempre true cuando hay Nginx delante de la app
TRUST_PROXY=true

# ── Frontend (no cambiar) ─────────────────────────────────────────────────────
# Indica al servidor que use /app/public del build Docker, no ../frontend
FRONTEND_FROM_BUILD=true
