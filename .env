DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/gestion_compras?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tu-refresh-secreto-super-seguro-cambiar-en-produccion
JWT_REFRESH_EXPIRES_IN=7d
API_PORT=3001
API_PREFIX=api/v1
API_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NODE_ENV=development

# ============================================
# Microsoft Entra ID / Azure AD
# ============================================
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=tu-client-id-aqui
MICROSOFT_CLIENT_SECRET=tu-client-secret-aqui
MICROSOFT_REDIRECT_URI=http://localhost:3000

# Frontend Microsoft Config (NEXT_PUBLIC_ prefix for client-side access)
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=tu-client-id-aqui
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dominios corporativos permitidos (separados por coma, sin espacios)
MICROSOFT_ALLOWED_DOMAINS=

# Auto-aprovisionamiento de usuarios nuevos
MICROSOFT_AUTO_PROVISION=true

# Rol por defecto para usuarios auto-aprovisionados
MICROSOFT_DEFAULT_ROLE=solicitante

# ============================================
# Redis (Sesiones)
# ============================================
REDIS_SESSION_DB=1

# ============================================
# Sesiones
# ============================================
SESSION_TTL=86400
SESSION_COOKIE_NAME=session_id
